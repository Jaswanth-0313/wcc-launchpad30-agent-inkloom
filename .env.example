# Vite app environment variables
# Use the project credentials already in your environment and keep secrets out of source control.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-key
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
VITE_APP_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:10000

# Render backend environment variables. Keep these server-side only.
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=your-openai-model
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/
MONGODB_DB_NAME=inkloom
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
APP_ORIGIN=http://localhost:5173
